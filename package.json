{
  "name": "referrer-capture-astro",
  "version": "1.0.0",
  "description": "Lead attribution capture for Astro sites. Records the visitor's source, medium, and channel, and attaches it to contact form submissions.",
  "keywords": [
    "astro",
    "attribution",
    "utm",
    "lead-source",
    "marketing-attribution",
    "cloudflare-pages",
    "referrer"
  ],
  "license": "MIT",
  "author": "Garrett Digital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garrettatx/referrer-capture-astro.git"
  },
  "bugs": {
    "url": "https://github.com/garrettatx/referrer-capture-astro/issues"
  },
  "homepage": "https://github.com/garrettatx/referrer-capture-astro#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.10.0"
  }
}
